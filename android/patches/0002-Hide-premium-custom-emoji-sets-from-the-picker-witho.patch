From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: telegram-custom <telegram-custom@users.noreply.github.com>
Date: Wed, 23 Sep 2026 17:12:21 -0400
Subject: [PATCH] Hide premium custom emoji sets from the picker without
 Premium

Without Premium, EmojiView no longer lists the locked (premium) part of
installed emoji sets or featured sets containing premium emoji. Free sets,
the free part of mixed sets, and the group's emoji set stay.
---
 .../src/main/java/org/telegram/ui/Components/EmojiView.java    | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/EmojiView.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/EmojiView.java
index 4f46a0c5..5a5ea676 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/EmojiView.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/EmojiView.java
@@ -7655,7 +7655,7 @@ public class EmojiView extends FrameLayout implements
                         pack.expanded = true;
                         emojipacksProcessed.add(pack);
                     }
-                    if (premiumEmojis.size() > 0) {
+                    if (false && premiumEmojis.size() > 0) { // telegram-custom: hide locked emoji instead of showing them locked
                         EmojiPack pack = new EmojiPack();
                         pack.index = index++;
                         pack.set = set.set;
@@ -7699,6 +7699,7 @@ public class EmojiView extends FrameLayout implements
                         break;
                     }
                 }
+                if (premium && !isPremium) continue; // telegram-custom: hide sets we can't send
                 pack.free = !premium;
                 pack.expanded = expandedEmojiSets.contains(pack.set.id);
                 pack.featured = true;
-- 
