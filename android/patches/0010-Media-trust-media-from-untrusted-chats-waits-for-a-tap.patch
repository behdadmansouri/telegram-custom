+
+    // Called as the chat's ⋮ menu opens: label and visibility follow the
+    // current verdict (a toast or another device-side change may have moved it).
+    public void updateMenuItem(ActionBarMenuItem headerItem, long dialogId) {
+        if (headerItem == null) {
+            return;
+        }
+        final View view = headerItem.getSubItem(MENU_ID);
