+package org.telegram.messenger;
+
+// telegram-custom: the media trust rule table (docs/trust.md section 1), pure
+// Java with no Android or app imports, so CI can unit-test it with plain javac
+// (android/tests/TrustRulesTest.java). Mirrors desktop's custom_trust_rules.h.
+public final class TrustRules {
+
+    private TrustRules() {
+    }
+
+    // Dialog kind.
+    public static final int KIND_SELF = 0; // Saved Messages
+    public static final int KIND_SERVICE = 1; // the Telegram service account, 777000 exactly
+    public static final int KIND_PERSON = 2;
+    public static final int KIND_BOT = 3;
+    public static final int KIND_GROUP = 4; // basic groups and supergroups
+    public static final int KIND_CHANNEL = 5; // broadcast channels
+
+    // Hand mark, as stored.
+    public static final int MARK_NONE = 0;
+    public static final int MARK_TRUSTED = 1;
+    public static final int MARK_NEVER = 2;
+
+    // Verdict for a dialog.
+    public static final int WHY_OFF = 0; // trust model off: stock everywhere
+    public static final int WHY_NEVER = 1; // rule 1
+    public static final int WHY_OWN = 2; // rule 2: Saved Messages, service account
+    public static final int WHY_HAND = 3; // rule 3: group, channel or bot marked by hand
+    public static final int WHY_ADMIN = 4; // rule 4: group you created, channel you created or admin
+    public static final int WHY_GRACE = 5; // rule 5: person marked less than `grace` days ago
+    public static final int WHY_ACTIVE = 6; // rule 6: marked person with enough active days
+    public static final int WHY_ACTIVE_CONTACT = 7; // rule 7
+    public static final int WHY_DORMANT = 8; // marked person below the threshold
+    public static final int WHY_UNTRUSTED = 9; // rule 9
+
+    public static final long SERVICE_USER_ID = 777000;
+    public static final int KEEP_DAYS = 365;
+
+    public static final class Settings {
+        public boolean on = true;
+        public int n = 3; // active days needed (1-30)
+        public int d = 90; // window, days (7-365)
+        public int grace = 90; // days a fresh hand mark trusts on its own (0-365)
+        public boolean admin = true; // rule 4
+        public boolean contacts = true; // rule 7
+        public boolean sender = false; // rule 8
+        public boolean tap = true; // untrusted chats: tap to load
+        public boolean relay = true; // untrusted calls: relay only
+    }
+
+    public static int clamp(int value, int min, int max) {
+        return Math.max(min, Math.min(max, value));
+    }
+
+    public static boolean isTrusted(int why) {
+        switch (why) {
+            case WHY_OFF:
+            case WHY_OWN:
+            case WHY_HAND:
+            case WHY_ADMIN:
+            case WHY_GRACE:
+            case WHY_ACTIVE:
+            case WHY_ACTIVE_CONTACT:
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    // A person whose own trust widens their messages in a group (rule 8).
+    public static boolean isTrustedSender(int why) {
+        return why == WHY_GRACE || why == WHY_ACTIVE || why == WHY_ACTIVE_CONTACT;
+    }
+
+    // Rules 0-7 and 9, first match wins. Rule 2's own-message clause and rule
+    // 8 are per message: allowsMessage() below.
+    public static int decide(int kind, boolean creatorOrAdmin, boolean contact, int mark, long markedAt, int activeDays, long now, Settings s) {
+        final boolean person = kind == KIND_PERSON;
+        final boolean chat = kind == KIND_GROUP || kind == KIND_CHANNEL;
+        if (!s.on) {
+            return WHY_OFF;
+        } else if (mark == MARK_NEVER) {
+            return WHY_NEVER;
+        } else if (kind == KIND_SELF || kind == KIND_SERVICE) {
+            return WHY_OWN;
+        } else if (!person && mark == MARK_TRUSTED) {
+            return WHY_HAND;
+        } else if (chat && s.admin && creatorOrAdmin) {
+            return WHY_ADMIN;
+        } else if (person && mark == MARK_TRUSTED) {
+            if (now - markedAt < (long) s.grace * 86400L) {
+                return WHY_GRACE;
+            } else if (activeDays >= s.n) {
+                return WHY_ACTIVE;
+            }
+        }
+        if (person && s.contacts && contact && activeDays >= s.n) {
+            return WHY_ACTIVE_CONTACT;
+        } else if (person && mark == MARK_TRUSTED) {
+            return WHY_DORMANT;
+        }
+        return WHY_UNTRUSTED;
+    }
+
+    // One message: `chatWhy` is the dialog's verdict, `ownOriginal` is a
+    // message you sent that is not a forward, `senderWhy` the sender's own
+    // verdict when rule 8 applies (a person in a group; -1 otherwise).
+    // "Never" beats both the own-message clause and rule 8.
+    public static boolean allowsMessage(int chatWhy, boolean ownOriginal, int senderWhy, Settings s) {
+        if (chatWhy == WHY_NEVER) {
+            return false;
+        } else if (ownOriginal || isTrusted(chatWhy)) {
+            return true;
+        }
+        return s.sender && isTrustedSender(senderWhy);
+    }
+
+    // Local calendar day of a unixtime, given the zone offset at that time.
+    public static int day(long unixtime, int offsetSeconds) {
+        final long v = unixtime + offsetSeconds;
+        return (int) (v >= 0 ? v / 86400L : (v - 86399L) / 86400L);
+    }
+}
