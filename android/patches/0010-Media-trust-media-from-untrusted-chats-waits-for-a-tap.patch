+    // ---- taps (this session) ----
+
+    private boolean isTapped(long dialogId, int id) {
+        synchronized (tapped) {
+            final SparseBooleanArray ids = tapped.get(dialogId);
+            return ids != null && ids.get(id);
+        }
+    }
+
+    private void addTapped(long dialogId, int id) {
+        synchronized (tapped) {
+            SparseBooleanArray ids = tapped.get(dialogId);
+            if (ids == null) {
+                tapped.put(dialogId, ids = new SparseBooleanArray());
+            }
+            ids.put(id, true);
+        }
+    }
+
+    // First tap on a waiting message in a chat cell (didPressButton and
+    // didClickedImage): true when it newly unlocks something you see (the
+    // cell then rebinds instead of running the tap). Voice and music taps,
+    // and messages with no picture (locations, contacts, polls), run as stock.
+    public static boolean noteTapped(MessageObject messageObject) {
+        if (messageObject == null || messageObject.messageOwner == null || !gateActive()) {
+            return false;
+        }
+        final TrustController tc = getInstance(messageObject.currentAccount);
+        if (tc.allows(messageObject.messageOwner)) {
+            return false;
+        }
+        tc.addTapped(messageObject.getDialogId(), messageObject.getId());
+        if (messageObject.isVoice() || messageObject.isMusic()) {
+            return false;
+        }
+        final TLRPC.MessageMedia media = MessageObject.getMedia(messageObject.messageOwner);
+        return messageObject.getDocument() != null || MessageObject.isPhoto(messageObject.messageOwner)
+            || media instanceof TLRPC.TL_messageMediaWebPage || media instanceof TLRPC.TL_messageMediaStory;
+    }
+
+    // A message allowed now, for callers outside the cells (notifications,
+    // the voice playlist): taps included, no toast off the UI thread.
+    public static boolean allowsMessage(MessageObject messageObject) {
+        return messageObject == null || getInstance(messageObject.currentAccount).allows(messageObject);
+    }
+
+    // Voice playlist: drop waiting messages, so playback does not advance
+    // into (and preload) a stranger's next voice note.
+    public static void trimPlaylist(ArrayList<MessageObject> playlist) {
+        if (playlist == null || !gateActive()) {
+            return;
+        }
+        for (int a = playlist.size() - 1; a >= 1; a--) { // index 0 is the one you started
+            if (!allowsMessage(playlist.get(a))) {
+                playlist.remove(a);
+            }
+        }
+    }
+
+    // ---- image gate G (ImageReceiver.setImage) ----
+
+    // Returns null to pass everything through (no allocation), otherwise the
+    // new {media, image, thumb} locations.
+    // parentObject is a MessageObject, or a StoryItem: a forwarded story's
+    // preview in a chat cell (StoriesUtilities.setImage), judged by the
+    // cell's message.
+    public static ImageLocation[] filter(ImageReceiver receiver, Object parentObject, ImageLocation media, ImageLocation image, ImageLocation thumb) {
+        final View parent = receiver.getParentView();
+        final MessageObject messageObject;
+        if (parentObject instanceof MessageObject) {
+            if (!(parent instanceof ChatMessageCell || parent instanceof DialogCell || parent instanceof BackupImageView && isChatBar(parent))) {
+                return null; // viewers, shared media, anything you opened yourself
+            }
+            messageObject = (MessageObject) parentObject;
+        } else if (parent instanceof ChatMessageCell) {
+            messageObject = ((ChatMessageCell) parent).getMessageObject();
+        } else if (parent instanceof ChatActionCell) {
+            messageObject = ((ChatActionCell) parent).getMessageObject(); // story mention
+        } else {
+            return null; // the story viewer and story lists
+        }
+        if (messageObject == null || messageObject.messageOwner == null) {
+            return null;
+        }
+        final TrustController tc = getInstance(messageObject.currentAccount);
+        if (receiver.isForceLoding()) {
+            if (!tc.allows(messageObject.messageOwner)) {
+                tc.addTapped(messageObject.getDialogId(), messageObject.getId());
+            }
+            return null;
+        }
+        if (tc.allows(messageObject.messageOwner)) {
+            return null;
+        }
+        if (messageObject.isDice() || messageObject.isAnimatedEmoji() || messageObject.isAnimatedEmojiStickers()) {
+            return null; // official dice and emoji packs: the result is the animation
+        }
+        final TLRPC.Document document = messageObject.getDocument();
+        if (document != null && (MessageObject.isStickerDocument(document) || MessageObject.isAnimatedStickerDocument(document, true))) {
+            if (!MessageObject.isAnimatedStickerDocument(document, true) && !MessageObject.isVideoStickerDocument(document)) {
+                return null; // static sticker
+            }
+            if (media == null && image == null) {
+                return null;
+            }
+            return new ImageLocation[]{null, null, thumb}; // still picture: thumb and outline
+        }
+        final ImageLocation m = isLocal(media, messageObject) ? media : null;
+        final ImageLocation i = isLocal(image, messageObject) ? image : null;
+        final ImageLocation t = isLocal(thumb, messageObject) ? thumb : null;
+        if (m == media && i == image && t == thumb) {
+            return null;
+        }
+        return new ImageLocation[]{m, i, t};
+    }
+
+    // A BackupImageView counts only as the open chat's pinned-message or
+    // composer reply bar: not inside a list (shared files, downloads, the
+    // legacy media grid) and with a chat on top.
+    private static boolean isChatBar(View view) {
+        if (!(LaunchActivity.getSafeLastFragment() instanceof ChatActivity)) {
+            return false;
+        }
+        for (ViewParent p = view.getParent(); p != null; p = p.getParent()) {
+            if (p instanceof RecyclerView || p instanceof AbsListView) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static boolean isLocal(ImageLocation location, MessageObject messageObject) {
+        if (location == null) {
+            return true;
+        } else if (location.photoSize instanceof TLRPC.TL_photoStrippedSize || location.photoSize instanceof TLRPC.TL_photoPathSize) {
+            return true; // bytes inside the message
+        } else if (location.path != null) {
+            // a local file, not a direct URL, and not a cached video to autoplay
+            return !location.path.startsWith("http") && location.imageType != FileLoader.IMAGE_TYPE_ANIMATION;
+        } else if (location.webFile != null) {
+            return !location.webFile.noproxy; // fetched by Telegram (static maps)
+        } else if (location.secureDocument != null) {
+            return true;
+        }
+        // A cached photo shows; GIF, video and document locations stay off
+        // even when cached, so nothing autoplays.
+        return location.document == null && location.photo != null && messageObject.mediaExists && MessageObject.isPhoto(messageObject.messageOwner);
+    }
+
+    // ---- toast, menu, rebind ----
+
+    private void maybeToast(long dialogId, int why) {
+        if (why == TrustRules.WHY_NEVER || Looper.myLooper() != Looper.getMainLooper()) {
+            return;
+        }
+        synchronized (toasted) {
+            if (toasted.contains(dialogId)) {
+                return;
+            }
+        }
+        final BaseFragment fragment = LaunchActivity.getSafeLastFragment();
+        if (!(fragment instanceof ChatActivity) || fragment.getCurrentAccount() != currentAccount || ((ChatActivity) fragment).getDialogId() != dialogId) {
+            return;
+        }
+        synchronized (toasted) {
+            toasted.add(dialogId);
+        }
+        AndroidUtilities.runOnUIThread(() -> {
+            if (LaunchActivity.getSafeLastFragment() != fragment) {
+                return;
+            }
+            BulletinFactory.of(fragment).createSimpleBulletin(R.raw.info, "Media here waits for a tap", "Trust this chat", () -> setMark(dialogId, TrustRules.MARK_TRUSTED)).show();
+        });
+    }
+
+    // After a mark change (or a refresh, dialogId 0: any chat of this
+    // account): rebind the open chat's cells so the gates re-run.
+    private void rebindOpenChat(long dialogId) {
+        final BaseFragment fragment = LaunchActivity.getSafeLastFragment();
+        if (!(fragment instanceof ChatActivity) || fragment.getCurrentAccount() != currentAccount) {
+            return;
+        }
+        if (dialogId != 0 && trustKey(((ChatActivity) fragment).getDialogId()) != trustKey(dialogId)) {
+            return;
+        }
+        final RecyclerListView listView = ((ChatActivity) fragment).getChatListView();
+        if (listView == null || listView.getAdapter() == null) {
+            return;
+        }
+        for (int a = 0, n = listView.getChildCount(); a < n; a++) {
+            final View child = listView.getChildAt(a);
+            if (child instanceof ChatMessageCell && ((ChatMessageCell) child).getMessageObject() != null) {
+                ((ChatMessageCell) child).getMessageObject().forceUpdate = true;
+            }
+        }
+        listView.getAdapter().notifyDataSetChanged();
+    }
+
+    public boolean menuShown(long dialogId) {
+        final int why = verdict(dialogId);
+        return why != TrustRules.WHY_OFF && why != TrustRules.WHY_OWN;
+    }
+
+    // Same state-first labels as desktop.
+    public String menuText(long dialogId) {
+        switch (verdict(dialogId)) {
+            case TrustRules.WHY_NEVER: return "Never trusted · Clear";
+            case TrustRules.WHY_HAND:
+            case TrustRules.WHY_GRACE:
+            case TrustRules.WHY_ACTIVE: return "Trusted (you) · Untrust";
+            case TrustRules.WHY_ADMIN: return "Trusted (admin) · Never trust";
+            case TrustRules.WHY_ACTIVE_CONTACT: return "Trusted (active contact) · Never trust";
+            case TrustRules.WHY_DORMANT: return "Dormant (you) · Trust again";
+            case TrustRules.WHY_OFF:
+            case TrustRules.WHY_OWN: return "Media trust";
+            default: return "Untrusted · Trust this chat";
+        }
+    }
+
+    public void menuClicked(long dialogId) {
+        switch (verdict(dialogId)) {
+            case TrustRules.WHY_NEVER:
+            case TrustRules.WHY_HAND:
+            case TrustRules.WHY_GRACE:
+            case TrustRules.WHY_ACTIVE: setMark(dialogId, TrustRules.MARK_NONE); break;
+            case TrustRules.WHY_ADMIN:
+            case TrustRules.WHY_ACTIVE_CONTACT: setMark(dialogId, TrustRules.MARK_NEVER); break;
+            case TrustRules.WHY_OFF:
+            case TrustRules.WHY_OWN: break;
+            default: setMark(dialogId, TrustRules.MARK_TRUSTED); break;
