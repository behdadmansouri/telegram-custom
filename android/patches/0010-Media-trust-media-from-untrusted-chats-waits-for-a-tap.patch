+
+    // ---- activity log (storage queue) ----
+
+    private static int offset(long unixtime) {
+        return TimeZone.getDefault().getOffset(unixtime * 1000L) / 1000;
+    }
+
+    private static int today() {
+        final long now = System.currentTimeMillis() / 1000;
+        return TrustRules.day(now, offset(now));
+    }
+
+    // The private-chat peer of an incoming regular message, or 0.
+    private static long incomingPeer(TLRPC.Message message, long selfId) {
+        if (message == null || message.out || message.action != null || message.peer_id == null) {
+            return 0;
+        }
+        long dialogId = message.dialog_id;
+        if (dialogId == 0) {
+            if (message.peer_id.chat_id != 0 || message.peer_id.channel_id != 0) {
+                return 0;
+            }
+            dialogId = message.from_id == null || message.guestchat_via_from != null ? message.peer_id.user_id : message.from_id.user_id;
+        }
+        return DialogObject.isUserDialog(dialogId) && dialogId != selfId ? dialogId : 0;
+    }
+
+    private static final String CREATE = "CREATE TABLE IF NOT EXISTS tc_activity(uid INTEGER, day INTEGER, PRIMARY KEY(uid, day))";
+
+    // Top of MessagesStorage.putMessagesInternal (realtime) and of
+    // putMessages(messages_Messages, ...) (history pages), storage queue.
+    public void noteIncoming(ArrayList<TLRPC.Message> messages, int mode) {
+        if (messages == null || messages.isEmpty() || mode != 0) {
+            return;
+        }
+        SQLitePreparedStatement state = null;
+        try {
+            final SQLiteDatabase database = getMessagesStorage().getDatabase();
+            if (database == null) {
+                return;
+            }
+            final long selfId = getUserConfig().getClientUserId();
+            final int today = today();
+            boolean changed = false;
+            for (int a = 0; a < messages.size(); a++) {
+                final TLRPC.Message message = messages.get(a);
+                final long uid = incomingPeer(message, selfId);
+                if (uid == 0) {
+                    continue;
+                }
+                final int day = TrustRules.day(message.date, offset(message.date));
+                if (day < today - TrustRules.KEEP_DAYS || day > today + 1) {
+                    continue;
+                }
+                SparseBooleanArray days = logged.get(uid);
+                if (days != null && days.get(day)) {
+                    continue; // this person already has this day
+                }
+                if (state == null) {
+                    database.executeFast(CREATE).stepThis().dispose();
+                    state = database.executeFast("INSERT OR IGNORE INTO tc_activity VALUES(?, ?)");
+                }
+                state.requery();
+                state.bindLong(1, uid);
+                state.bindInteger(2, day);
+                state.step();
+                if (days == null) {
+                    logged.put(uid, days = new SparseBooleanArray());
+                }
+                days.put(day, true);
+                changed = true;
+            }
+            if (changed) {
+                queueRefresh(2000);
+            }
+        } catch (Exception e) {
+            FileLog.e(e);
+        } finally {
+            if (state != null) {
+                state.dispose();
+            }
+        }
+    }
+
+    private void queueRefresh(long delay) {
+        getMessagesStorage().getStorageQueue().postRunnable(() -> {
+            if (refreshQueued) {
+                return;
+            }
+            refreshQueued = true;
+            getMessagesStorage().getStorageQueue().postRunnable(() -> {
+                refreshQueued = false;
+                refresh();
+            }, delay);
+        });
+    }
+
+    // Storage queue: prune, backfill once, read the active-day counts.
+    private void refresh() {
+        SQLiteCursor cursor = null;
+        try {
+            final SQLiteDatabase database = getMessagesStorage().getDatabase();
+            if (database == null) {
+                return;
+            }
+            final int today = today();
+            database.executeFast(CREATE).stepThis().dispose();
+            database.executeFast(CREATE_META).stepThis().dispose();
+            if (!backfillRunning && backfillFrom(database) != BACKFILL_DONE) {
+                backfillRunning = true;
+                getMessagesStorage().getStorageQueue().postRunnable(this::backfillStep);
+            }
+            database.executeFast("DELETE FROM tc_activity WHERE day < " + (today - TrustRules.KEEP_DAYS)).stepThis().dispose();
+            // Active days inside the window (today and the d - 1 days before).
+            final int first = today - settings().d + 1;
+            final LongSparseArray<SparseBooleanArray> all = new LongSparseArray<>();
+            final LongSparseArray<Integer> next = new LongSparseArray<>();
+            cursor = database.queryFinalized("SELECT uid, day FROM tc_activity");
+            while (cursor.next()) {
+                final long uid = cursor.longValue(0);
+                final int day = cursor.intValue(1);
+                SparseBooleanArray days = all.get(uid);
+                if (days == null) {
+                    all.put(uid, days = new SparseBooleanArray());
+                }
+                days.put(day, true);
+                if (day >= first) {
+                    final Integer count = next.get(uid);
+                    next.put(uid, count == null ? 1 : count + 1);
+                }
+            }
+            cursor.dispose();
+            cursor = null;
+            logged = all;
+            activeDays = next;
+            clearVerdicts();
+            if (!refreshedOnce) {
+                refreshedOnce = true;
+                AndroidUtilities.runOnUIThread(() -> rebindOpenChat(0)); // cells bound before the counts were in
+            }
+        } catch (Exception e) {
+            FileLog.e(e);
+        } finally {
+            if (cursor != null) {
+                cursor.dispose();
+            }
+        }
+    }
+
+    // Backfill progress lives in its own row (tc_meta 'backfill'): the last
+    // messages_v2 rowid done, or BACKFILL_DONE. Not the table's existence: the
+    // live feed may create tc_activity first. The account database goes away
+    // on logout, so a new login backfills again.
+    private static final String CREATE_META = "CREATE TABLE IF NOT EXISTS tc_meta(k TEXT PRIMARY KEY, v INTEGER)";
+    private static final long BACKFILL_DONE = -1;
+    private static final int BACKFILL_CHUNK = 2000;
+    private boolean backfillRunning; // storage queue only
+    private LongSparseArray<SparseBooleanArray> backfillSeen; // storage queue only
+
+    private static long backfillFrom(SQLiteDatabase database) throws Exception {
+        SQLiteCursor cursor = null;
+        try {
+            cursor = database.queryFinalized("SELECT v FROM tc_meta WHERE k = 'backfill'");
+            return cursor.next() ? cursor.longValue(0) : 0;
+        } finally {
+            if (cursor != null) {
+                cursor.dispose();
+            }
+        }
+    }
+
+    // Count what is still cached, with the live feed's rules: one chunk of
+    // messages_v2 rows per storage-queue turn, in one transaction, with an
+    // in-memory (uid, day) dedupe, so chat loads and sends interleave.
+    private void backfillStep() {
+        SQLiteCursor cursor = null;
+        SQLitePreparedStatement state = null;
+        SQLiteDatabase database = null;
+        boolean transaction = false;
+        boolean more = false;
+        boolean failed = false;
+        try {
+            database = getMessagesStorage().getDatabase();
+            if (database == null) {
+                backfillRunning = false;
+                return;
+            }
+            final long from = backfillFrom(database);
+            if (from == BACKFILL_DONE) {
+                backfillRunning = false;
+                return;
+            }
+            if (backfillSeen == null) {
+                backfillSeen = new LongSparseArray<>();
+            }
+            final long selfId = getUserConfig().getClientUserId();
+            final int today = today();
+            final long since = System.currentTimeMillis() / 1000 - TrustRules.KEEP_DAYS * 86400L;
+            database.beginTransaction();
+            transaction = true;
+            state = database.executeFast("INSERT OR IGNORE INTO tc_activity VALUES(?, ?)");
+            cursor = database.queryFinalized("SELECT rowid, uid, date, out, data FROM messages_v2 WHERE rowid > " + from + " ORDER BY rowid LIMIT " + BACKFILL_CHUNK);
+            long last = from;
+            int rows = 0;
+            while (cursor.next()) {
+                rows++;
+                last = cursor.longValue(0);
+                final long uid = cursor.longValue(1);
+                final int date = cursor.intValue(2);
+                if (cursor.intValue(3) != 0 || date < since || !DialogObject.isUserDialog(uid) || uid == selfId) {
+                    continue;
+                }
+                final int day = TrustRules.day(date, offset(date));
+                if (day < today - TrustRules.KEEP_DAYS || day > today + 1) {
+                    continue;
+                }
+                SparseBooleanArray days = backfillSeen.get(uid);
+                if (days != null && days.get(day)) {
+                    continue;
+                }
+                final NativeByteBuffer data = cursor.byteBufferValue(4);
+                if (data == null) {
+                    continue;
+                }
+                final TLRPC.Message message = TLRPC.Message.TLdeserialize(data, data.readInt32(false), false);
+                data.reuse();
+                if (message == null || message.action != null || message.out) {
+                    continue;
+                }
+                state.requery();
+                state.bindLong(1, uid);
+                state.bindInteger(2, day);
+                state.step();
+                if (days == null) {
+                    backfillSeen.put(uid, days = new SparseBooleanArray());
+                }
+                days.put(day, true);
+            }
+            cursor.dispose();
+            cursor = null;
+            more = rows == BACKFILL_CHUNK;
+            final SQLitePreparedStatement meta = database.executeFast("REPLACE INTO tc_meta VALUES('backfill', ?)");
+            meta.requery();
+            meta.bindLong(1, more ? last : BACKFILL_DONE);
+            meta.step();
+            meta.dispose();
+        } catch (Exception e) {
+            FileLog.e(e);
+            failed = true; // retried by the next 6-hourly refresh, not in a loop
+        } finally {
+            if (cursor != null) {
+                cursor.dispose();
+            }
+            if (state != null) {
+                state.dispose();
+            }
+            if (transaction) {
+                database.commitTransaction();
+            }
+        }
+        if (more && !failed) {
+            getMessagesStorage().getStorageQueue().postRunnable(this::backfillStep);
+        } else {
+            backfillRunning = false;
+            backfillSeen = null;
+            if (!failed) {
+                queueRefresh(0);
+            }
+        }
+    }
+}
