+package org.telegram.messenger;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.Looper;
+import android.os.SystemClock;
+import android.util.LongSparseArray;
+import android.util.SparseBooleanArray;
+import android.view.View;
+import android.view.ViewParent;
+import android.widget.AbsListView;
+
+import androidx.recyclerview.widget.RecyclerView;
+
+import org.telegram.SQLite.SQLiteCursor;
+import org.telegram.SQLite.SQLiteDatabase;
+import org.telegram.SQLite.SQLitePreparedStatement;
+import org.telegram.tgnet.NativeByteBuffer;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.ui.ActionBar.ActionBarMenuItem;
+import org.telegram.ui.ActionBar.ActionBarMenuSubItem;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.Cells.ChatActionCell;
+import org.telegram.ui.Cells.ChatMessageCell;
+import org.telegram.ui.Cells.DialogCell;
+import org.telegram.ui.ChatActivity;
+import org.telegram.ui.Components.BackupImageView;
+import org.telegram.ui.Components.BulletinFactory;
+import org.telegram.ui.Components.RecyclerListView;
+import org.telegram.ui.LaunchActivity;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Set;
+import java.util.TimeZone;
+
+// telegram-custom: media trust (docs/trust.md). Media from chats you do not
+// trust waits for a tap: no auto-download, only the embedded blurred
+// thumbnail, nothing autoplays, animated stickers stay still, no story
+// preload, calls relay-only. The rules are TrustRules (pure, unit-tested);
+// this class feeds them per account: hand marks (prefs), contacts, chat
+// flags and per-person active days (own table tc_activity in the account's
+// cache database). Everything stays on this device.
+public class TrustController extends BaseController {
+
+    public static final int MENU_ID = 9100; // chat menu item, ChatActivity
+
+    private static final String PREFS = "telegram_custom"; // CustomSettings' file
+    private static final long VERDICT_TTL_MS = 60 * 1000L;
+    private static final long REFRESH_EVERY_MS = 6 * 60 * 60 * 1000L;
+
+    private static volatile TrustRules.Settings settings;
+
+    private static final TrustController[] Instance = new TrustController[UserConfig.MAX_ACCOUNT_COUNT];
+
+    public static TrustController getInstance(int num) {
+        TrustController localInstance = Instance[num];
+        if (localInstance == null) {
+            synchronized (TrustController.class) {
+                localInstance = Instance[num];
+                if (localInstance == null) {
+                    Instance[num] = localInstance = new TrustController(num);
+                }
+            }
+        }
+        return localInstance;
+    }
+
+    // Snapshots, replaced whole (never mutated after publishing).
+    private volatile HashMap<Long, long[]> marks; // key -> {state, markedAt}; null until loaded
+    private volatile LongSparseArray<Integer> activeDays = new LongSparseArray<>(); // user id -> days in window
+    private volatile long refreshedAt = -REFRESH_EVERY_MS - 1;
+    private boolean refreshQueued; // storage queue only
+    private boolean refreshedOnce; // storage queue only
+    private LongSparseArray<SparseBooleanArray> logged = new LongSparseArray<>(); // storage queue only: uid -> days in tc_activity
+    private volatile long userId; // whose marks and activity the snapshots hold
+
+    private final LongSparseArray<Integer> verdicts = new LongSparseArray<>(); // guarded by itself
+    private long verdictsAt;
+    private final LongSparseArray<SparseBooleanArray> tapped = new LongSparseArray<>(); // guarded by itself
+    private final HashSet<Long> toasted = new HashSet<>(); // guarded by itself
+
+    public TrustController(int num) {
+        super(num);
+    }
+
+    // ---- settings (global, one set for all accounts) ----
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    public static TrustRules.Settings settings() {
+        TrustRules.Settings s = settings;
+        if (s == null) {
+            final SharedPreferences p = prefs();
+            s = new TrustRules.Settings();
+            s.on = p.getBoolean("trust_on", s.on);
+            s.n = TrustRules.clamp(p.getInt("trust_n", s.n), 1, 30);
+            s.d = TrustRules.clamp(p.getInt("trust_d", s.d), 7, 365);
+            s.grace = TrustRules.clamp(p.getInt("trust_grace", s.grace), 0, 365);
+            s.admin = p.getBoolean("trust_admin", s.admin);
+            s.contacts = p.getBoolean("trust_contacts", s.contacts);
+            s.sender = p.getBoolean("trust_sender", s.sender);
+            s.tap = p.getBoolean("trust_tap", s.tap);
+            s.relay = p.getBoolean("trust_relay", s.relay);
+            settings = s;
+        }
+        return s;
+    }
+
+    public static void saveSettings(TrustRules.Settings s) {
+        prefs().edit()
+            .putBoolean("trust_on", s.on)
+            .putInt("trust_n", s.n)
+            .putInt("trust_d", s.d)
+            .putInt("trust_grace", s.grace)
+            .putBoolean("trust_admin", s.admin)
+            .putBoolean("trust_contacts", s.contacts)
+            .putBoolean("trust_sender", s.sender)
+            .putBoolean("trust_tap", s.tap)
+            .putBoolean("trust_relay", s.relay)
+            .apply();
+        settings = s;
+        for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {
+            final TrustController tc = Instance[a];
+            if (tc != null) {
+                tc.clearVerdicts();
+                tc.queueRefresh(0);
+            }
+        }
+    }
+
+    public static TrustRules.Settings copySettings() {
+        final TrustRules.Settings s = settings();
+        final TrustRules.Settings c = new TrustRules.Settings();
+        c.on = s.on;
+        c.n = s.n;
+        c.d = s.d;
+        c.grace = s.grace;
+        c.admin = s.admin;
+        c.contacts = s.contacts;
+        c.sender = s.sender;
+        c.tap = s.tap;
+        c.relay = s.relay;
+        return c;
+    }
+
+    public static String summary() {
+        final TrustRules.Settings s = settings();
+        return s.on ? "On · " + s.n + " days in " + s.d : "Off";
+    }
+
+    // Tap to load is the gate every media hook checks.
+    public static boolean gateActive() {
+        final TrustRules.Settings s = settings();
+        return s.on && s.tap;
+    }
+
+    // Direct-URL web documents (fetched from your own IP) never load while
+    // the model is on, in any chat (no chat context where they are built).
+    public static boolean blockNoProxy() {
+        return settings().on;
+    }
+
+    // ---- marks (per account, keyed by the account's user id) ----
+
+    private String marksKey() {
+        return "trust_marks_" + getUserConfig().getClientUserId();
+    }
+
+    private HashMap<Long, long[]> marks() {
+        HashMap<Long, long[]> m = marks;
+        if (m == null) {
+            m = new HashMap<>();
+            for (String entry : prefs().getStringSet(marksKey(), Collections.emptySet())) {
+                final String[] parts = entry.split(":");
+                if (parts.length != 3) {
+                    continue; // kept as is in prefs: setMark only rewrites its own key
+                }
+                try {
+                    m.put(Long.parseLong(parts[0]), new long[]{Long.parseLong(parts[1]), Long.parseLong(parts[2])});
+                } catch (NumberFormatException ignore) {
+                }
+            }
+            marks = m;
+        }
+        return m;
+    }
+
+    // Secret chats take the peer user's trust.
+    private long trustKey(long dialogId) {
+        if (DialogObject.isEncryptedDialog(dialogId)) {
+            final TLRPC.EncryptedChat chat = getMessagesController().getEncryptedChat(DialogObject.getEncryptedChatId(dialogId));
+            return chat != null ? chat.user_id : 0;
+        }
+        return dialogId;
+    }
+
+    public void setMark(long dialogId, int state) {
+        final long key = trustKey(dialogId);
+        if (key == 0) {
+            return;
+        }
+        final long now = System.currentTimeMillis() / 1000;
+        final String prefix = key + ":";
+        final Set<String> next = new HashSet<>();
+        for (String entry : prefs().getStringSet(marksKey(), Collections.emptySet())) {
+            if (!entry.startsWith(prefix)) {
+                next.add(entry); // other marks, unparseable ones included, survive
+            }
+        }
+        final HashMap<Long, long[]> m = new HashMap<>(marks());
+        if (state == TrustRules.MARK_NONE) {
+            m.remove(key);
+        } else {
+            next.add(key + ":" + state + ":" + now);
+            m.put(key, new long[]{state, now});
+        }
+        prefs().edit().putStringSet(marksKey(), next).apply();
+        marks = m;
+        clearVerdicts();
+        AndroidUtilities.runOnUIThread(() -> rebindOpenChat(dialogId));
+    }
+
+    // ---- verdicts ----
+
+    private void clearVerdicts() {
+        synchronized (verdicts) {
+            verdicts.clear();
+            verdictsAt = SystemClock.elapsedRealtime();
+        }
+    }
+
+    public int verdict(long dialogId) {
+        final TrustRules.Settings s = settings();
+        if (!s.on) {
+            return TrustRules.WHY_OFF;
+        }
+        final long now = SystemClock.elapsedRealtime();
+        final long self = getUserConfig().getClientUserId();
+        if (self != userId) {
+            // first use, or another login in this account slot
+            userId = self;
+            marks = null;
+            activeDays = new LongSparseArray<>();
+            synchronized (toasted) {
+                toasted.clear();
+            }
+            clearVerdicts();
+            refreshedAt = now;
+            queueRefresh(0);
+        } else if (now - refreshedAt > REFRESH_EVERY_MS) {
+            refreshedAt = now;
+            queueRefresh(0);
+        }
+        final long key = trustKey(dialogId);
+        if (key == 0) {
+            return TrustRules.WHY_UNTRUSTED;
+        }
+        synchronized (verdicts) {
+            if (now - verdictsAt > VERDICT_TTL_MS) {
+                verdicts.clear();
+                verdictsAt = now;
+            }
+            final Integer cached = verdicts.get(key);
+            if (cached != null) {
+                return cached;
+            }
+        }
+        final int why = compute(key, s);
+        // A marked user not loaded yet would be judged as a person (a bot
+        // mark never decays): do not cache that guess.
+        if (key > 0 && getMessagesController().getUser(key) == null && marks().containsKey(key)) {
+            return why;
+        }
+        synchronized (verdicts) {
+            verdicts.put(key, why);
+        }
+        return why;
+    }
+
+    private int compute(long key, TrustRules.Settings s) {
+        int kind;
+        boolean creatorOrAdmin = false;
+        boolean contact = false;
+        if (key > 0) {
+            final TLRPC.User user = getMessagesController().getUser(key);
+            if (key == getUserConfig().getClientUserId()) {
+                kind = TrustRules.KIND_SELF;
+            } else if (key == TrustRules.SERVICE_USER_ID) {
+                kind = TrustRules.KIND_SERVICE;
+            } else if (user != null && user.bot) {
+                kind = TrustRules.KIND_BOT;
+            } else {
+                kind = TrustRules.KIND_PERSON;
+                contact = user != null && user.contact || getContactsController().contactsDict.containsKey(key);
+            }
+        } else {
+            final TLRPC.Chat chat = getMessagesController().getChat(-key);
+            final boolean broadcast = chat != null && ChatObject.isChannelAndNotMegaGroup(chat);
+            kind = broadcast ? TrustRules.KIND_CHANNEL : TrustRules.KIND_GROUP;
+            creatorOrAdmin = chat != null && (chat.creator || broadcast && ChatObject.hasAdminRights(chat));
+        }
+        final long[] mark = marks().get(key);
+        final Integer days = activeDays.get(key);
+        return TrustRules.decide(kind, creatorOrAdmin, contact,
+            mark == null ? TrustRules.MARK_NONE : (int) mark[0], mark == null ? 0 : mark[1],
+            days == null ? 0 : days, System.currentTimeMillis() / 1000, s);
+    }
