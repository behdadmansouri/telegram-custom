+    public boolean allows(TLRPC.Message message) {
+        if (message == null || !gateActive()) {
+            return true;
+        }
+        final long dialogId = MessageObject.getDialogId(message);
+        if (isTapped(dialogId, message.id)) {
+            return true;
+        }
+        final TrustRules.Settings s = settings();
+        final int why = verdict(dialogId);
+        int senderWhy = -1;
+        if (s.sender && !TrustRules.isTrusted(why) && why != TrustRules.WHY_NEVER && dialogId < 0) {
+            final long from = MessageObject.getFromChatId(message);
+            if (from > 0 && kindIsGroup(dialogId)) {
+                senderWhy = verdict(from);
+            }
+        }
+        final boolean own = message.out && message.fwd_from == null;
+        if (TrustRules.allowsMessage(why, own, senderWhy, s)) {
+            return true;
+        }
+        maybeToast(dialogId, why);
+        return false;
+    }
