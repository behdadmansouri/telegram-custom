diff --git a/TMessagesProj/src/main/java/org/telegram/ui/TrustSettingsActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/TrustSettingsActivity.java
new file mode 100644
index 00000000..b84de7df
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/ui/TrustSettingsActivity.java
@@ -0,0 +1,105 @@
+package org.telegram.ui;
+
+import android.view.View;
+
+import org.telegram.messenger.TrustController;
+import org.telegram.messenger.TrustRules;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.Components.NumberPicker;
+import org.telegram.ui.Components.UItem;
+import org.telegram.ui.Components.UniversalAdapter;
+import org.telegram.ui.Components.UniversalFragment;
+
+import java.util.ArrayList;
+
+// telegram-custom: Settings -> Media trust (docs/trust.md 2.9). One screen,
+// nine rows, same wording as the desktop box. Global for all accounts.
+public class TrustSettingsActivity extends UniversalFragment {
+
+    private static final int ROW_ON = 1;
+    private static final int ROW_TAP = 2;
+    private static final int ROW_RELAY = 3;
+    private static final int ROW_ADMIN = 4;
+    private static final int ROW_CONTACTS = 5;
+    private static final int ROW_SENDER = 6;
+    private static final int ROW_N = 7;
+    private static final int ROW_D = 8;
+    private static final int ROW_GRACE = 9;
+
+    @Override
+    protected CharSequence getTitle() {
+        return "Media trust";
+    }
+
+    @Override
+    protected void fillItems(ArrayList<UItem> items, UniversalAdapter adapter) {
+        final TrustRules.Settings s = TrustController.settings();
+        items.add(UItem.asCheck(ROW_ON, "Trust model on").setChecked(s.on));
+        items.add(UItem.asCheck(ROW_TAP, "Untrusted chats: tap to load").setChecked(s.tap));
+        items.add(UItem.asCheck(ROW_RELAY, "Untrusted calls: relay only").setChecked(s.relay));
+        items.add(UItem.asShadow("Media from chats you do not trust waits for a tap: only the blurred preview shows, nothing autoplays, animated stickers stay still. Mark a chat from its ⋮ menu."));
+        items.add(UItem.asCheck(ROW_ADMIN, "Trust groups and channels I run").setChecked(s.admin));
+        items.add(UItem.asCheck(ROW_CONTACTS, "Trust active contacts").setChecked(s.contacts));
+        items.add(UItem.asCheck(ROW_SENDER, "Trust trusted senders in groups").setChecked(s.sender));
+        items.add(UItem.asShadow(null));
+        items.add(UItem.asButton(ROW_N, "Active days needed (1-30)", String.valueOf(s.n)));
+        items.add(UItem.asButton(ROW_D, "Counted over the last days (7-365)", String.valueOf(s.d)));
+        items.add(UItem.asButton(ROW_GRACE, "A hand mark trusts for days (0-365)", String.valueOf(s.grace)));
+        items.add(UItem.asShadow("An active day is a day the person wrote to you in your private chat, as seen by this device. Marks and activity stay on this device."));
+    }
+
+    @Override
+    protected void onClick(UItem item, View view, int position, float x, float y) {
+        final TrustRules.Settings s = TrustController.copySettings();
+        switch (item.id) {
+            case ROW_ON: s.on = !s.on; break;
+            case ROW_TAP: s.tap = !s.tap; break;
+            case ROW_RELAY: s.relay = !s.relay; break;
+            case ROW_ADMIN: s.admin = !s.admin; break;
+            case ROW_CONTACTS: s.contacts = !s.contacts; break;
+            case ROW_SENDER: s.sender = !s.sender; break;
+            case ROW_N: pickNumber(item.id, "Active days needed", 1, 30, s.n); return;
+            case ROW_D: pickNumber(item.id, "Counted over the last days", 7, 365, s.d); return;
+            case ROW_GRACE: pickNumber(item.id, "A hand mark trusts for days", 0, 365, s.grace); return;
+            default: return;
+        }
+        TrustController.saveSettings(s);
+        listView.adapter.update(true);
+    }
+
+    private void pickNumber(int row, String title, int min, int max, int value) {
+        if (getParentActivity() == null) {
+            return;
+        }
+        final NumberPicker picker = new NumberPicker(getParentActivity());
+        picker.setMinValue(min);
+        picker.setMaxValue(max);
+        picker.setValue(value);
+        picker.setWrapSelectorWheel(false);
+        final AlertDialog.Builder builder = new AlertDialog.Builder(getParentActivity());
+        builder.setTitle(title);
+        builder.setView(picker);
+        builder.setNegativeButton("Cancel", null);
+        builder.setPositiveButton("Save", (dialog, which) -> {
+            final TrustRules.Settings s = TrustController.copySettings();
+            final int v = TrustRules.clamp(picker.getValue(), min, max);
+            if (row == ROW_N) {
+                s.n = v;
+            } else if (row == ROW_D) {
+                s.d = v;
+            } else {
+                s.grace = v;
+            }
+            TrustController.saveSettings(s);
+            if (listView != null) {
+                listView.adapter.update(true);
+            }
+        });
+        showDialog(builder.create());
+    }
+
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        return false;
+    }
+}
-- 
