From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: telegram-custom <telegram-custom@users.noreply.github.com>
Date: Wed, 23 Sep 2026 17:11:43 -0400
Subject: [PATCH] No ads: sponsored messages, search ads, promoted chat

Short-circuits messages.getSponsoredMessages (chat list + video ads),
contacts.getSponsoredPeers in search, and drops the help.getPromoData peer
so no proxy-sponsor/promoted chat is ever pinned.
---
 .../main/java/org/telegram/messenger/MessagesController.java    | 2 ++
 .../src/main/java/org/telegram/messenger/video/VideoAds.java    | 1 +
 .../java/org/telegram/ui/Adapters/DialogsSearchAdapter.java     | 2 +-
 3 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java b/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
index 93bc81cb..337c6288 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
@@ -10878,6 +10878,7 @@ public class MessagesController extends BaseController implements NotificationCe
                 noDialog = true;
             } else if (response instanceof TLRPC.TL_help_promoData) {
                 TLRPC.TL_help_promoData res = (TLRPC.TL_help_promoData) response;
+                res.peer = null; // telegram-custom: no promoted chat
 
                 long did;
                 if (res.peer == null) {
@@ -21652,6 +21653,7 @@ public class MessagesController extends BaseController implements NotificationCe
     }
 
     public SponsoredMessagesInfo getSponsoredMessages(long dialogId) {
+        if (true) return null; // telegram-custom: no ads
         SponsoredMessagesInfo info = sponsoredMessages.get(dialogId);
         if (info != null && (info.loading || Math.abs(SystemClock.elapsedRealtime() - info.loadTime) <= 5 * 60 * 1000)) {
             return info;
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/video/VideoAds.java b/TMessagesProj/src/main/java/org/telegram/messenger/video/VideoAds.java
index a402447d..9acbd37d 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/video/VideoAds.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/video/VideoAds.java
@@ -194,6 +194,7 @@ public static VideoAds make(
     private boolean loading, loaded;
     private void load() {
         if (loading || loaded) return;
+        if (true) return; // telegram-custom: no ads
 
         if (UserConfig.getInstance(currentAccount).isPremium() && MessagesController.getInstance(currentAccount).isSponsoredDisabled()) {
             return;
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Adapters/DialogsSearchAdapter.java b/TMessagesProj/src/main/java/org/telegram/ui/Adapters/DialogsSearchAdapter.java
index 4146704a..e95a0d47 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Adapters/DialogsSearchAdapter.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Adapters/DialogsSearchAdapter.java
@@ -1131,7 +1131,7 @@ public class DialogsSearchAdapter extends RecyclerListView.SelectionAdapter {
                 ConnectionsManager.getInstance(currentAccount).cancelRequest(sponsoredReqId, true);
                 sponsoredReqId = 0;
             }
-            if (query == null || query.length() < 4 || UserConfig.getInstance(currentAccount).isPremium() && MessagesController.getInstance(currentAccount).isSponsoredDisabled()) {
+            if (true || query == null || query.length() < 4 || UserConfig.getInstance(currentAccount).isPremium() && MessagesController.getInstance(currentAccount).isSponsoredDisabled()) { // telegram-custom: no search ads
                 sponsoredQuery = null;
             } else {
                 final TLRPC.TL_contacts_getSponsoredPeers req = new TLRPC.TL_contacts_getSponsoredPeers();
-- 
