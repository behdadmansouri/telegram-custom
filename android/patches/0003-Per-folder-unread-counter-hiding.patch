Subject: [PATCH] Per-folder unread counter hiding

Long-press a folder tab -> Hide/Show unread counter. Stored per account in
the telegram_custom SharedPreferences via a new CustomSettings class that
later patches reuse. "All chats" is filter id 0.
---
 .../telegram/messenger/CustomSettings.java    | 36 +++++++++++++++++++
 .../java/org/telegram/ui/DialogsActivity.java |  7 ++++
 2 files changed, 43 insertions(+)
 create mode 100644 TMessagesProj/src/main/java/org/telegram/messenger/CustomSettings.java

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/CustomSettings.java b/TMessagesProj/src/main/java/org/telegram/messenger/CustomSettings.java
new file mode 100644
index 00000000..a5be5540
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/CustomSettings.java
@@ -0,0 +1,36 @@
+package org.telegram.messenger;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.Set;
+
+// telegram-custom: our own settings, in their own SharedPreferences file so
+// they never touch upstream's settings code (keeps rebases trivial).
+public class CustomSettings {
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences("telegram_custom", Context.MODE_PRIVATE);
+    }
+
+    // Folders whose unread badge is hidden, by DialogFilter.id per account
+    // (toggled from the folder tab's long-press menu). 0 is "All chats".
+    private static String hiddenCountersKey(int account) {
+        return "hiddenFolderCounters" + account;
+    }
+
+    public static boolean isFolderCounterHidden(int account, int filterId) {
+        return prefs().getStringSet(hiddenCountersKey(account), Collections.emptySet()).contains(String.valueOf(filterId));
+    }
+
+    public static void toggleFolderCounterHidden(int account, int filterId) {
+        Set<String> set = new HashSet<>(prefs().getStringSet(hiddenCountersKey(account), Collections.emptySet()));
+        String id = String.valueOf(filterId);
+        if (!set.remove(id)) {
+            set.add(id);
+        }
+        prefs().edit().putStringSet(hiddenCountersKey(account), set).apply();
+    }
+}
