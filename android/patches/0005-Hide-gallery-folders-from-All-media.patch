From: Bmans <bmans054@uottawa.ca>
Date: Sat, 26 Sep 2026 08:24:51 -0400
Subject: [PATCH] Hide gallery folders from All media

Long-press a folder in the attach menu's album dropdown to leave it out of
All media / All photos / All videos (every picker, stories included). The
folder itself stays in the list, marked "hidden"; long-press again to bring
it back. Stored device-wide in CustomSettings.
---
 .../telegram/messenger/CustomSettings.java    | 21 +++++++++++++++++++
 .../telegram/messenger/MediaController.java   | 21 +++++++++++--------
 .../ChatAttachAlertPhotoLayout.java           | 12 ++++++++++-
 3 files changed, 44 insertions(+), 10 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/CustomSettings.java b/TMessagesProj/src/main/java/org/telegram/messenger/CustomSettings.java
index 5014cc59..356a2924 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/CustomSettings.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/CustomSettings.java
@@ -129,4 +129,25 @@ public class CustomSettings {
         }
         return true;
     }
+
+    // Gallery folders (MediaStore bucket ids) left out of "All media" /
+    // "All photos" / "All videos" in every picker; the folder itself stays in
+    // the album list. Device-wide, not per account. Toggled by long-pressing
+    // the folder in the attach menu's album dropdown.
+    public static Set<String> hiddenGalleryBuckets() {
+        return prefs().getStringSet("hiddenGalleryBuckets", Collections.emptySet());
+    }
+
+    public static boolean isGalleryBucketHidden(int bucketId) {
+        return hiddenGalleryBuckets().contains(String.valueOf(bucketId));
+    }
+
+    public static void toggleGalleryBucketHidden(int bucketId) {
+        Set<String> set = new HashSet<>(prefs().getStringSet("hiddenGalleryBuckets", Collections.emptySet()));
+        String id = String.valueOf(bucketId);
+        if (!set.remove(id)) {
+            set.add(id);
+        }
+        prefs().edit().putStringSet("hiddenGalleryBuckets", set).apply();
+    }
 }
