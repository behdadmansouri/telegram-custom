@@ -12,4 +12,10 @@ namespace Custom {
 [[nodiscard]] rpl::producer<bool> FolderCounterHiddenValue(FilterId id);
 void ToggleFolderCounterHidden(FilterId id);
 
+// Ghost mode: no read receipts (chats, threads, voice/video listened, stories),
+// no typing/upload status, no online status, no view-count increments.
+// Sending a message still shows you online for a moment (server-side).
+[[nodiscard]] bool GhostMode();
+void SetGhostMode(bool enabled);
+
 } // namespace Custom
