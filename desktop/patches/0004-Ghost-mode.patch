diff --git a/Telegram/SourceFiles/custom/custom_settings.cpp b/Telegram/SourceFiles/custom/custom_settings.cpp
index 33115cab..425da95c 100644
--- a/Telegram/SourceFiles/custom/custom_settings.cpp
+++ b/Telegram/SourceFiles/custom/custom_settings.cpp
@@ -14,6 +14,7 @@ namespace {
 
 struct State {
 	base::flat_set<FilterId> hiddenFolderCounters;
+	bool ghostMode = false;
 	rpl::event_stream<> changes;
 };
 
@@ -33,6 +34,7 @@ State &Get() {
 			for (const auto &id : list) {
 				state.hiddenFolderCounters.emplace(FilterId(id.toInt()));
 			}
+			state.ghostMode = object.value(u"ghostMode"_q).toBool();
 		}
 	}
 	return state;
@@ -45,6 +47,7 @@ void Save() {
 	}
 	auto object = QJsonObject();
 	object.insert(u"hiddenFolderCounters"_q, list);
+	object.insert(u"ghostMode"_q, Get().ghostMode);
 
 	// Atomic: a crash mid-write can't truncate the old file.
 	auto file = QSaveFile(Path());
@@ -77,4 +80,17 @@ void ToggleFolderCounterHidden(FilterId id) {
 	state.changes.fire({});
 }
 
+bool GhostMode() {
+	return Get().ghostMode;
+}
+
+void SetGhostMode(bool enabled) {
+	auto &state = Get();
+	if (state.ghostMode != enabled) {
+		state.ghostMode = enabled;
+		Save();
+		state.changes.fire({});
+	}
+}
+
 } // namespace Custom
diff --git a/Telegram/SourceFiles/custom/custom_settings.h b/Telegram/SourceFiles/custom/custom_settings.h
