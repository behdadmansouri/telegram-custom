+// telegram-custom: our own settings, kept in <workdir>/custom.json so they
+// never touch upstream's settings serialization (keeps rebases trivial).
+#pragma once
+
+#include "data/data_types.h"
+
+namespace Custom {
+
+// Folders whose unread badge is hidden (per folder, toggled from the folder
+// tab's context menu). 0 is "All chats".
+[[nodiscard]] bool FolderCounterHidden(FilterId id);
+[[nodiscard]] rpl::producer<bool> FolderCounterHiddenValue(FilterId id);
+void ToggleFolderCounterHidden(FilterId id);
+
+} // namespace Custom
