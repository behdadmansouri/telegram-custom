+// telegram-custom: see custom_settings.h.
+#include "custom/custom_settings.h"
+
+#include "settings.h"
+
+#include <QtCore/QFile>
+#include <QtCore/QSaveFile>
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+
+namespace Custom {
+namespace {
+
+struct State {
+	base::flat_set<FilterId> hiddenFolderCounters;
+	rpl::event_stream<> changes;
+};
+
+[[nodiscard]] QString Path() {
+	return cWorkingDir() + u"custom.json"_q;
+}
+
+State &Get() {
+	static auto state = State();
+	static auto loaded = false;
+	if (!loaded) {
+		loaded = true;
+		auto file = QFile(Path());
+		if (file.open(QIODevice::ReadOnly)) {
+			const auto object = QJsonDocument::fromJson(file.readAll()).object();
+			const auto list = object.value(u"hiddenFolderCounters"_q).toArray();
+			for (const auto &id : list) {
+				state.hiddenFolderCounters.emplace(FilterId(id.toInt()));
+			}
+		}
+	}
+	return state;
+}
+
+void Save() {
+	auto list = QJsonArray();
+	for (const auto id : Get().hiddenFolderCounters) {
+		list.push_back(int(id));
+	}
+	auto object = QJsonObject();
+	object.insert(u"hiddenFolderCounters"_q, list);
+
+	// Atomic: a crash mid-write can't truncate the old file.
+	auto file = QSaveFile(Path());
+	if (file.open(QIODevice::WriteOnly)) {
+		file.write(QJsonDocument(object).toJson());
+		file.commit();
+	}
+}
+
+} // namespace
+
+bool FolderCounterHidden(FilterId id) {
+	return Get().hiddenFolderCounters.contains(id);
+}
+
+rpl::producer<bool> FolderCounterHiddenValue(FilterId id) {
+	return Get().changes.events_starting_with(
+		rpl::empty_value()
+	) | rpl::map([=] {
+		return FolderCounterHidden(id);
+	}) | rpl::distinct_until_changed();
+}
+
+void ToggleFolderCounterHidden(FilterId id) {
+	auto &state = Get();
+	if (!state.hiddenFolderCounters.remove(id)) {
+		state.hiddenFolderCounters.emplace(id);
+	}
+	Save();
+	state.changes.fire({});
+}
+
+} // namespace Custom
