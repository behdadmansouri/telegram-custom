From 92c0f2f3e28b119f533ffa1f7ce58ec543f789a4 Mon Sep 17 00:00:00 2001
From: Bmans <bmans054@uottawa.ca>
Date: Wed, 23 Sep 2026 15:02:45 -0400
Subject: [PATCH 2/3] Hide premium custom emoji sets from the picker without
 Premium

---
 Telegram/SourceFiles/chat_helpers/emoji_list_widget.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/Telegram/SourceFiles/chat_helpers/emoji_list_widget.cpp b/Telegram/SourceFiles/chat_helpers/emoji_list_widget.cpp
index 7185af0a..967032a1 100644
--- a/Telegram/SourceFiles/chat_helpers/emoji_list_widget.cpp
+++ b/Telegram/SourceFiles/chat_helpers/emoji_list_widget.cpp
@@ -3514,7 +3514,11 @@ void EmojiListWidget::refreshCustom() {
 	auto old = base::take(_custom);
 	const auto session = &this->session();
 	const auto premiumPossible = session->premiumPossible();
-	const auto onlyUnicodeEmoji = _onlyUnicodeEmoji || !premiumPossible;
+	// telegram-custom: without Premium, hide sets we can't send instead of
+	// showing them locked. Free and group sets stay.
+	const auto onlyUnicodeEmoji = _onlyUnicodeEmoji
+		|| !premiumPossible
+		|| (!session->premium() && !_allowWithoutPremium);
 	const auto premiumMayBeBought = (!onlyUnicodeEmoji)
 		&& premiumPossible
 		&& !session->premium()
-- 
