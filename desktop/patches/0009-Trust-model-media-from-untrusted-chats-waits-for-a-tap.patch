+
+using namespace TrustRules;
+
+constexpr auto kKeepDays = 365;
+constexpr auto kSaveDelay = crl::time(10000);
+constexpr auto kVerdictTtl = crl::time(60000); // contacts, admin rights
+
+struct Account {
+	QString path;
+	// peer id -> mark, markedAt. An explicit None hides the stock lists.
+	base::flat_map<uint64, std::pair<Mark, int64>> marks;
+	// Stock "Always" list: peer id -> first seen (the mark's date).
+	base::flat_map<uint64, int64> stockSeen;
+	// Private-chat activity: peer id -> sorted local Julian days.
+	base::flat_map<uint64, std::vector<int>> days;
+	base::flat_map<not_null<PeerData*>, Why> verdicts;
+	crl::time verdictsAt = 0;
+	Main::Session *session = nullptr; // caches above belong to it
+	bool dirty = false;
+};
+
+struct Global {
+	TrustSettings settings;
+	base::flat_map<uint64, std::unique_ptr<Account>> accounts;
+	base::flat_set<not_null<PeerData*>> toasted;
+	base::Timer *saveTimer = nullptr; // never freed: lives until exit
+	rpl::event_stream<> changes;
+};
+
+const HistoryItem *CurrentItem = nullptr;
+
+[[nodiscard]] QString SettingsPath() {
+	return cWorkingDir() + u"custom.json"_q;
+}
+
+[[nodiscard]] QJsonObject ReadObject(const QString &path) {
+	auto file = QFile(path);
+	return file.open(QIODevice::ReadOnly)
+		? QJsonDocument::fromJson(file.readAll()).object()
+		: QJsonObject();
+}
+
+void WriteObject(const QString &path, const QJsonObject &object) {
+	// Atomic: a crash mid-write can't truncate the old file.
+	auto file = QSaveFile(path);
+	if (file.open(QIODevice::WriteOnly)) {
+		file.write(QJsonDocument(object).toJson(QJsonDocument::Compact));
+		file.commit();
+	}
+}
+
+void LoadSettings(TrustSettings &s) {
+	const auto o = ReadObject(SettingsPath()).value(u"trust"_q).toObject();
+	const auto flag = [&](const QString &key, bool &value) {
+		value = o.value(key).toBool(value);
+	};
+	const auto number = [&](const QString &key, int &value, int lo, int hi) {
+		value = std::clamp(o.value(key).toInt(value), lo, hi);
+	};
+	flag(u"on"_q, s.on);
+	number(u"n"_q, s.n, 1, 30);
+	number(u"d"_q, s.d, 7, 365);
+	number(u"grace"_q, s.grace, 0, 365);
+	flag(u"admin"_q, s.admin);
+	flag(u"contacts"_q, s.contacts);
+	flag(u"sender"_q, s.sender);
+	flag(u"tap"_q, s.tap);
+	flag(u"relay"_q, s.relay);
+}
+
+void SaveSettings(const TrustSettings &s) {
+	auto o = QJsonObject();
+	o.insert(u"on"_q, s.on);
+	o.insert(u"n"_q, s.n);
+	o.insert(u"d"_q, s.d);
+	o.insert(u"grace"_q, s.grace);
+	o.insert(u"admin"_q, s.admin);
+	o.insert(u"contacts"_q, s.contacts);
+	o.insert(u"sender"_q, s.sender);
+	o.insert(u"tap"_q, s.tap);
+	o.insert(u"relay"_q, s.relay);
+	auto object = ReadObject(SettingsPath()); // keep custom_settings' keys
+	object.insert(u"trust"_q, o);
+	WriteObject(SettingsPath(), object);
+}
+
+Global &G() {
+	static auto global = [] {
+		auto result = std::make_unique<Global>();
+		LoadSettings(result->settings);
+		return result;
+	}();
+	return *global;
+}
+
+[[nodiscard]] int Today() {
+	return int(QDate::currentDate().toJulianDay());
+}
+
+void LoadAccount(Account &account) {
+	auto object = QJsonObject();
+	auto file = QFile(account.path);
+	if (file.open(QIODevice::ReadOnly)) {
+		const auto bytes = file.readAll();
+		file.close();
+		auto error = QJsonParseError();
+		object = QJsonDocument::fromJson(bytes, &error).object();
+		if (error.error != QJsonParseError::NoError
+			&& !bytes.trimmed().isEmpty()) {
+			// Keep the marks for the user instead of overwriting them.
+			QFile::rename(
+				account.path,
+				(account.path
+					+ u".corrupt-"_q
+					+ QString::number(base::unixtime::now())));
+		}
+	}
+	const auto marks = object.value(u"marks"_q).toObject();
+	for (auto i = marks.begin(); i != marks.end(); ++i) {
+		const auto pair = i.value().toArray();
+		const auto state = pair.at(0).toInt();
+		if (state >= 0 && state <= 2) {
+			account.marks[i.key().toULongLong()] = {
+				Mark(state),
+				int64(pair.at(1).toDouble()),
+			};
+		}
+	}
+	const auto stock = object.value(u"stock"_q).toObject();
+	for (auto i = stock.begin(); i != stock.end(); ++i) {
+		account.stockSeen[i.key().toULongLong()] = int64(i.value().toDouble());
+	}
+	const auto min = Today() - kKeepDays;
+	const auto days = object.value(u"days"_q).toObject();
+	for (auto i = days.begin(); i != days.end(); ++i) {
+		auto list = std::vector<int>();
+		for (const auto &day : i.value().toArray()) {
+			if (day.toInt() >= min) {
+				list.push_back(day.toInt());
+			}
+		}
+		ranges::sort(list);
+		list.erase(ranges::unique(list), end(list));
+		if (!list.empty()) {
+			account.days[i.key().toULongLong()] = std::move(list);
+		}
+	}
+}
+
+void SaveAccount(Account &account) {
+	account.dirty = false;
+	auto marks = QJsonObject();
+	for (const auto &[peer, mark] : account.marks) {
+		marks.insert(QString::number(peer), QJsonArray{
+			int(mark.first),
+			double(mark.second),
+		});
+	}
+	auto stock = QJsonObject();
+	for (const auto &[peer, seen] : account.stockSeen) {
+		stock.insert(QString::number(peer), double(seen));
+	}
+	auto days = QJsonObject();
+	for (const auto &[peer, list] : account.days) {
+		auto array = QJsonArray();
+		for (const auto day : list) {
+			array.push_back(day);
+		}
+		days.insert(QString::number(peer), array);
+	}
+	auto object = QJsonObject();
+	object.insert(u"marks"_q, marks);
+	object.insert(u"stock"_q, stock);
+	object.insert(u"days"_q, days);
+	WriteObject(account.path, object);
+}
+
+void SaveDirty() {
+	for (const auto &[key, account] : G().accounts) {
+		if (account->dirty) {
+			SaveAccount(*account);
+		}
+	}
+}
+
+void ScheduleSave(Account &account) {
+	account.dirty = true;
+	auto &g = G();
+	if (!g.saveTimer) {
+		g.saveTimer = new base::Timer([] { SaveDirty(); });
+		if (const auto app = QCoreApplication::instance()) {
+			QObject::connect(app, &QCoreApplication::aboutToQuit, [] {
+				SaveDirty();
+			});
+		}
+	}
+	if (!g.saveTimer->isActive()) {
+		g.saveTimer->callOnce(kSaveDelay);
+	}
+}
+
+Account &AccountFor(not_null<Main::Session*> session) {
+	auto &g = G();
+	const auto key = session->uniqueId();
+	auto i = g.accounts.find(key);
+	if (i == end(g.accounts)) {
+		auto account = std::make_unique<Account>();
+		account->path = cWorkingDir()
+			+ u"trust_"_q
+			+ QString::number(key)
+			+ u".json"_q;
+		LoadAccount(*account);
+		i = g.accounts.emplace(key, std::move(account)).first;
+	}
+	auto &account = *i->second;
+	if (account.session != session.get()) {
+		// Verdicts and toasts are keyed by PeerData*: drop them with
+		// the session that owns those peers.
+		account.session = session.get();
+		account.verdicts.clear();
+		session->lifetime().add([key] {
+			auto &g = G();
+			const auto j = g.accounts.find(key);
+			if (j != end(g.accounts)) {
+				j->second->verdicts.clear();
+				j->second->session = nullptr;
+			}
+			g.toasted.clear();
+		});
+	}
+	return account;
+}
+
+[[nodiscard]] int ActiveDays(const Account &account, uint64 peer, int d) {
+	const auto i = account.days.find(peer);
+	if (i == end(account.days)) {
+		return 0;
+	}
+	const auto from = Today() - d + 1;
+	return int(ranges::count_if(i->second, [&](int day) {
+		return day >= from;
+	}));
+}
+
+[[nodiscard]] Why Compute(Account &account, not_null<PeerData*> peer) {
+	const auto &s = G().settings;
+	const auto key = peer->id.value;
+	auto in = TrustRules::Input();
+	if (const auto user = peer->asUser()) {
+		in.kind = UserKind(
+			user->isSelf(),
+			peerToUser(user->id).bare,
+			user->isBot());
+		in.contact = user->isContact();
+	} else if (const auto chat = peer->asChat()) {
+		in.kind = Kind::Group;
+		in.creatorOrAdmin = chat->amCreator();
+	} else if (const auto channel = peer->asChannel()) {
+		in.kind = channel->isMegagroup() ? Kind::Group : Kind::Channel;
+		in.creatorOrAdmin = channel->amCreator()
+			|| (channel->isBroadcast() && channel->hasAdminRights());
+	}
+	if (const auto i = account.marks.find(key); i != end(account.marks)) {
+		in.mark = i->second.first;
+		in.markedAt = i->second.second;
+	} else {
+		// Stock Settings -> Advanced -> Automatic media download lists:
+		// "Never" reads as never-trust, "Always" as a hand mark.
+		using Override = Data::AutoDownload::Override;
+		const auto override = peer->session().settings().autoDownload(
+		).peerOverride(peer->id);
+		if (override == Override::ForceDeny) {
+			in.mark = Mark::Never;
+		} else if (override == Override::ForceAllow) {
+			auto &seen = account.stockSeen[key];
+			if (!seen) {
+				seen = base::unixtime::now();
+				ScheduleSave(account);
+			}
+			in.mark = Mark::Trusted;
+			in.markedAt = seen;
+		}
+	}
+	in.activeDays = ActiveDays(account, key, s.d);
+	in.now = base::unixtime::now();
+	return Decide(in, TrustRules::Settings{
+		.on = s.on,
+		.n = s.n,
+		.d = s.d,
+		.grace = s.grace,
+		.admin = s.admin,
+		.contacts = s.contacts,
+	});
+}
+
+[[nodiscard]] Why Verdict(not_null<PeerData*> peer) {
+	if (!G().settings.on) {
+		return Why::Off;
+	}
+	auto &account = AccountFor(&peer->session());
+	const auto now = crl::now();
+	if (now - account.verdictsAt > kVerdictTtl) {
+		account.verdicts.clear();
+		account.verdictsAt = now;
+	}
+	const auto i = account.verdicts.find(peer);
+	if (i != end(account.verdicts)) {
+		return i->second;
+	}
+	const auto result = Compute(account, peer);
+	account.verdicts.emplace(peer, result);
+	return result;
+}
+
+void ClearVerdicts() {
+	for (const auto &[key, account] : G().accounts) {
+		account->verdicts.clear();
+	}
+}
+
+// Re-run the gates: loads stock would do now, and a repaint of the open
+// history so draw() re-checks autoplay and stickers.
+void Refresh(not_null<PeerData*> peer) {
+	auto &owner = peer->owner();
+	owner.photoLoadSettingsChanged();
+	owner.documentLoadSettingsChanged();
+	if (const auto history = owner.historyLoaded(peer.get())) {
+		for (const auto &block : history->blocks) {
+			for (const auto &view : block->messages) {
+				owner.requestViewRepaint(view.get());
+			}
+		}
+	}
+}
+
+// Settings are global: every account re-runs its gates.
+void RefreshAll() {
+	for (const auto &entry : Core::App().domain().accounts()) {
+		if (entry.account->sessionExists()) {
+			auto &owner = entry.account->session().data();
+			owner.photoLoadSettingsChanged();
+			owner.documentLoadSettingsChanged();
+		}
+	}
+	if (const auto window = Core::App().activeWindow()) {
+		if (const auto controller = window->sessionController()) {
+			if (const auto peer = controller->activeChatCurrent().peer()) {
+				Refresh(peer);
+			}
+		}
+	}
+}
+
+void SetMark(not_null<PeerData*> peer, Mark mark) {
+	auto &account = AccountFor(&peer->session());
+	account.marks[peer->id.value] = { mark, int64(base::unixtime::now()) };
+	account.verdicts.clear();
+	SaveAccount(account);
+	G().changes.fire({});
+	Refresh(peer);
+}
+
+// First refusal in the chat the active window shows, once per peer.
+void MaybeToast(not_null<PeerData*> peer) {
+	auto &g = G();
+	if (g.toasted.contains(peer)) {
+		return;
+	}
+	const auto window = Core::App().activeWindow();
+	const auto controller = window ? window->sessionController() : nullptr;
+	if (!controller
+		|| (&controller->session() != &peer->session())
+		|| (controller->activeChatCurrent().peer() != peer.get())) {
+		return;
+	}
+	g.toasted.emplace(peer);
+	const auto session = base::make_weak(&peer->session());
+	const auto peerId = peer->id;
+	crl::on_main([weak = base::make_weak(controller), session, peerId] {
+		const auto strong = weak.get();
+		if (!strong) {
+			return;
+		}
+		auto text = TextWithEntities{ u"Media here waits for a tap. "_q };
+		text.append(Ui::Text::Link(u"Trust this chat"_q));
+		strong->showToast(Ui::Toast::Config{
+			.text = std::move(text),
+			.filter = [=](const ClickHandlerPtr &, Qt::MouseButton button) {
+				if (button != Qt::LeftButton) {
+					return false;
+				}
+				if (const auto strong = session.get()) {
+					if (const auto peer = strong->data().peerLoaded(peerId)) {
+						SetMark(peer, Mark::Trusted);
+					}
+				}
+				return true;
+			},
+		});
+	});
+}
+
+[[nodiscard]] bool GateOn() {
+	const auto &s = G().settings;
+	return s.on && s.tap;
+}
+
+} // namespace
+
+TrustSettings Trust() {
+	return G().settings;
+}
+
+void SetTrust(const TrustSettings &settings) {
+	G().settings = settings;
+	SaveSettings(settings);
+	ClearVerdicts();
+	G().changes.fire({});
+	RefreshAll();
+}
+
+bool TrustOn() {
+	return G().settings.on;
+}
+
+bool Allows(not_null<const HistoryItem*> item) {
+	if (!GateOn()) {
+		return true;
+	}
+	const auto peer = item->history()->peer;
+	const auto verdict = Verdict(peer);
+	if (verdict == Why::Never) {
+		return false; // rule 1 first: beats rules 2 and 8, and no toast
+	} else if (IsTrusted(verdict)) {
+		return true;
+	} else if (item->out() && !item->Get<HistoryMessageForwarded>()) {
+		return true; // rule 2: your own message, not a forward
+	} else if (G().settings.sender && !peer->isUser() && !peer->isBroadcast()) {
+		// Rule 8: a trusted person's message inside a group.
+		const auto from = item->from();
+		if (from != peer && from->isUser() && !from->isBot()) {
+			const auto why = Verdict(from);
+			if (why == Why::Grace
+				|| why == Why::Active
+				|| why == Why::ActiveContact) {
+				return true;
+			}
+		}
+	}
+	MaybeToast(peer);
+	return false;
+}
+
+bool AllowsPeer(not_null<PeerData*> peer) {
+	if (!GateOn()) {
+		return true;
+	} else if (CurrentItem && CurrentItem->history()->peer == peer) {
+		return Allows(not_null<const HistoryItem*>(CurrentItem));
+	}
+	const auto verdict = Verdict(peer);
+	if (IsTrusted(verdict)) {
+		return true;
+	} else if (verdict != Why::Never) {
+		MaybeToast(peer);
+	}
+	return false;
+}
+
+bool CallP2PAllowed(not_null<UserData*> user) {
+	const auto &s = G().settings;
+	return !s.on || !s.relay || IsTrusted(Verdict(user));
+}
+
+TrustItemScope::TrustItemScope(const HistoryItem *item)
+: _previous(CurrentItem) {
+	CurrentItem = item;
+}
+
+TrustItemScope::~TrustItemScope() {
+	CurrentItem = _previous;
+}
+
+void NoteIncoming(not_null<HistoryItem*> item) {
+	const auto peer = item->history()->peer;
+	if (item->out()
+		|| !peer->isUser()
+		|| peer->isSelf()
+		|| item->isService()
+		|| !item->isRegular()) {
+		return;
+	}
+	const auto day = int(
+		QDateTime::fromSecsSinceEpoch(item->date()).date().toJulianDay());
+	const auto today = Today();
+	if (day < today - kKeepDays || day > today + 1) {
+		return;
+	}
+	auto &account = AccountFor(&peer->session());
+	auto &days = account.days[peer->id.value];
+	const auto i = ranges::lower_bound(days, day);
+	if (i != end(days) && *i == day) {
+		return;
+	}
+	days.insert(i, day);
+	const auto old = ranges::lower_bound(days, today - kKeepDays);
+	days.erase(begin(days), old);
+	account.verdicts.remove(peer);
+	ScheduleSave(account);
+}
+
+bool TrustMenuShown(not_null<PeerData*> peer) {
+	const auto why = Verdict(peer);
+	return (why != Why::Off) && (why != Why::Own);
+}
+
+QString TrustMenuText(not_null<PeerData*> peer) {
+	switch (Verdict(peer)) {
+	case Why::Never: return u"Never trusted · Clear"_q;
+	case Why::Hand:
+	case Why::Grace:
+	case Why::Active: return u"Trusted (you) · Untrust"_q;
+	case Why::Admin: return u"Trusted (admin) · Never trust"_q;
+	case Why::ActiveContact:
+		return u"Trusted (active contact) · Never trust"_q;
+	case Why::Dormant: return u"Dormant (you) · Trust again"_q;
+	default: return u"Untrusted · Trust this chat"_q;
+	}
+}
+
+void TrustMenuClicked(not_null<PeerData*> peer) {
+	switch (Verdict(peer)) {
+	case Why::Never:
+	case Why::Hand:
+	case Why::Grace:
+	case Why::Active: SetMark(peer, Mark::None); break;
+	case Why::Admin:
+	case Why::ActiveContact: SetMark(peer, Mark::Never); break;
+	case Why::Off:
+	case Why::Own: break;
+	default: SetMark(peer, Mark::Trusted); break;
+	}
+}
+
+rpl::producer<QString> TrustSummaryValue() {
+	return G().changes.events_starting_with(
+		rpl::empty_value()
+	) | rpl::map([] {
+		const auto &s = G().settings;
+		return s.on
+			? (u"On · %1 days in %2"_q.arg(s.n).arg(s.d))
+			: u"Off"_q;
+	});
+}
+
+void TrustSettingsBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Main::Session*> session) {
+	const auto s = G().settings;
+	box->setTitle(rpl::single(u"Media trust"_q));
+	const auto check = [&](const QString &text, bool value) {
+		const auto result = box->addRow(
+			object_ptr<Ui::Checkbox>(box, text, value));
+		box->addSkip(st::boxLittleSkip);
+		return result;
+	};
+	const auto number = [&](const QString &label, int value, int max) {
+		box->addRow(object_ptr<Ui::FlatLabel>(box, label, st::boxLabel));
+		// NumberInput is a QLineEdit, not an RpWidget: wrap it for addRow.
+		const auto wrap = box->addRow(object_ptr<Ui::FixedHeightWidget>(
+			box,
+			st::defaultInputField.heightMin));
+		const auto field = Ui::CreateChild<Ui::NumberInput>(
+			wrap,
+			st::defaultInputField,
+			rpl::single(QString()),
+			QString::number(value),
+			max);
+		wrap->widthValue() | rpl::on_next([=](int width) {
+			field->move(0, 0);
+			field->resize(width, field->height());
+			wrap->resize(width, field->height());
+		}, wrap->lifetime());
+		return field;
+	};
+	const auto on = check(u"Trust model on"_q, s.on);
+	const auto tap = check(u"Untrusted chats: tap to load"_q, s.tap);
+	const auto relay = check(u"Untrusted calls: relay only"_q, s.relay);
+	const auto admin = check(u"Trust groups and channels I run"_q, s.admin);
+	const auto contacts = check(u"Trust active contacts"_q, s.contacts);
+	const auto sender = check(u"Trust trusted senders in groups"_q, s.sender);
+	const auto n = number(u"Active days needed (1-30)"_q, s.n, 30);
+	const auto d = number(u"Counted over the last days (7-365)"_q, s.d, 365);
+	const auto grace = number(
+		u"A hand mark trusts for days (0-365)"_q,
+		s.grace,
+		365);
+	box->addButton(tr::lng_settings_save(), [=] {
+		const auto read = [](Ui::NumberInput *field, int was, int lo, int hi) {
+			auto ok = false;
+			const auto value = field->getLastText().toInt(&ok);
+			return ok ? std::clamp(value, lo, hi) : was;
+		};
+		auto now = G().settings;
+		now.on = on->checked();
+		now.tap = tap->checked();
+		now.relay = relay->checked();
+		now.admin = admin->checked();
+		now.contacts = contacts->checked();
+		now.sender = sender->checked();
+		now.n = read(n, now.n, 1, 30);
+		now.d = read(d, now.d, 7, 365);
+		now.grace = read(grace, now.grace, 0, 365);
+		SetTrust(now);
+		session->data().photoLoadSettingsChanged();
+		session->data().documentLoadSettingsChanged();
+		box->closeBox();
+	});
+	box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+}
+
+} // namespace Custom
