@@ -0,0 +1,79 @@
+// telegram-custom: media trust model (docs/trust.md). Media from chats you
+// have not come to trust waits for a tap: no automatic downloads, no network
+// thumbnails, no autoplay, no story preload, no direct-URL web documents,
+// calls relay-only. Global settings in custom.json, per-account marks and
+// activity log in <workdir>/trust_<account>.json. Per device, never synced.
+#pragma once
+
+#include "custom/custom_trust_rules.h"
+
+class PeerData;
+class UserData;
+class HistoryItem;
+
+namespace Main {
+class Session;
+} // namespace Main
+
+namespace Ui {
+class GenericBox;
+} // namespace Ui
+
+namespace Custom {
+
+struct TrustSettings {
+	bool on = true;
+	int n = 3;
+	int d = 90;
+	int grace = 90;
+	bool admin = true; // rule 4
+	bool contacts = true; // rule 7
+	bool sender = false; // rule 8
+	bool tap = true; // untrusted chats: tap to load
+	bool relay = true; // untrusted calls: relay only
+};
+
+[[nodiscard]] TrustSettings Trust();
+void SetTrust(const TrustSettings &settings);
+
+// Trust model on: direct-URL web documents never load.
+[[nodiscard]] bool TrustOn();
+
+// May this message's media load, play or preview automatically?
+[[nodiscard]] bool Allows(not_null<const HistoryItem*> item);
+
+// Gates that only see a peer: the item of an enclosing TrustItemScope
+// when it belongs to that peer, else the chat's verdict.
+[[nodiscard]] bool AllowsPeer(not_null<PeerData*> peer);
+
+// May a 1:1 call with this user go peer-to-peer?
+[[nodiscard]] bool CallP2PAllowed(not_null<UserData*> user);
+
+class TrustItemScope final {
+public:
+	explicit TrustItemScope(const HistoryItem *item);
+	~TrustItemScope();
+
+	TrustItemScope(const TrustItemScope &) = delete;
+	TrustItemScope &operator=(const TrustItemScope &) = delete;
+
+private:
+	const HistoryItem *_previous = nullptr;
+
+};
+
+// Activity feed: every message item as it is created (history.cpp).
+void NoteIncoming(not_null<HistoryItem*> item);
+
+// Chat menu: state-first label, and its action.
+[[nodiscard]] bool TrustMenuShown(not_null<PeerData*> peer);
+[[nodiscard]] QString TrustMenuText(not_null<PeerData*> peer);
+void TrustMenuClicked(not_null<PeerData*> peer);
+
+// Settings -> Advanced -> Automatic media download -> Media trust.
+[[nodiscard]] rpl::producer<QString> TrustSummaryValue();
+void TrustSettingsBox(
+	not_null<Ui::GenericBox*> box,
+	not_null<Main::Session*> session);
+
+} // namespace Custom
diff --git a/Telegram/SourceFiles/custom/custom_trust_rules.h b/Telegram/SourceFiles/custom/custom_trust_rules.h
new file mode 100644
index 00000000..45f3c0ec
--- /dev/null
+++ b/Telegram/SourceFiles/custom/custom_trust_rules.h
@@ -0,0 +1,114 @@
+// telegram-custom: the media trust rule table (docs/trust.md section 1),
+// pure and dependency-free so CI can unit-test it without building the app.
+#pragma once
+
+#include <cstdint>
+
+namespace Custom::TrustRules {
+
+enum class Kind : std::uint8_t {
+	Self, // Saved Messages
+	Service, // the Telegram service account (777000)
+	Person,
+	Bot,
+	Group, // basic groups and supergroups
+	Channel, // broadcast channels
+};
+
+enum class Mark : std::uint8_t {
+	None = 0,
+	Trusted = 1,
+	Never = 2,
+};
+
+enum class Why : std::uint8_t {
+	Off, // trust model off: stock everywhere
+	Never, // rule 1
+	Own, // rule 2: Saved Messages, service account
+	Hand, // rule 3: group, channel or bot marked by hand
+	Admin, // rule 4: group you created, channel you created or admin
+	Grace, // rule 5: person marked less than `grace` days ago
+	Active, // rule 6: marked person with enough active days
+	ActiveContact, // rule 7
+	Dormant, // marked person below the threshold: untrusted until active
+	Untrusted, // rule 9
+};
+
+struct Settings {
+	bool on = true;
+	int n = 3; // active days needed
+	int d = 90; // window, days
+	int grace = 90; // days a fresh hand mark trusts on its own
+	bool admin = true; // rule 4
+	bool contacts = true; // rule 7
+};
+
+struct Input {
+	Kind kind = Kind::Person;
+	bool creatorOrAdmin = false; // rule 4 scope, computed by the caller
+	bool contact = false;
+	Mark mark = Mark::None;
+	std::int64_t markedAt = 0; // unixtime
+	int activeDays = 0; // active days within the last `d`
+	std::int64_t now = 0; // unixtime
+};
+
+// Only the real service account (777000) is Service: tdesktop's
+// isServiceUser() is "id divisible by 1000", which ordinary accounts hit.
+[[nodiscard]] constexpr Kind UserKind(
+		bool self,
+		std::uint64_t userId,
+		bool bot) {
+	return self
+		? Kind::Self
+		: (userId == 777000)
+		? Kind::Service
+		: bot
+		? Kind::Bot
+		: Kind::Person;
+}
+
+[[nodiscard]] constexpr bool IsTrusted(Why why) {
+	switch (why) {
+	case Why::Off:
+	case Why::Own:
+	case Why::Hand:
+	case Why::Admin:
+	case Why::Grace:
+	case Why::Active:
+	case Why::ActiveContact: return true;
+	default: return false;
+	}
+}
+
+// Rules 0-7 and 9, first match wins. Rule 2's own-message clause and
+// rule 8 (trusted sender in a group) are per message, applied by the caller.
+[[nodiscard]] constexpr Why Decide(const Input &in, const Settings &s) {
+	const auto person = (in.kind == Kind::Person);
+	const auto chat = (in.kind == Kind::Group) || (in.kind == Kind::Channel);
+	if (!s.on) {
+		return Why::Off;
+	} else if (in.mark == Mark::Never) {
+		return Why::Never;
+	} else if (in.kind == Kind::Self || in.kind == Kind::Service) {
+		return Why::Own;
+	} else if (!person && in.mark == Mark::Trusted) {
+		return Why::Hand;
+	} else if (chat && s.admin && in.creatorOrAdmin) {
+		return Why::Admin;
+	} else if (person && in.mark == Mark::Trusted) {
+		if (in.now - in.markedAt < std::int64_t(s.grace) * 86400) {
+			return Why::Grace;
+		} else if (in.activeDays >= s.n) {
+			return Why::Active;
+		}
+	}
+	if (person && s.contacts && in.contact && in.activeDays >= s.n) {
+		return Why::ActiveContact;
+	} else if (person && in.mark == Mark::Trusted) {
+		return Why::Dormant;
+	}
+	return Why::Untrusted;
+}
+
+} // namespace Custom::TrustRules
