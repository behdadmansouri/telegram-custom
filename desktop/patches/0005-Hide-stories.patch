From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bmans <bmans054@uottawa.ca>
Date: Wed, 23 Sep 2026 15:05:38 -0400
Subject: [PATCH] Hide stories

No story rings on avatars (peers report no active/unread stories) and the
stories strip above the chat list never loads. Profile story sections and
posting your own are untouched.
---
 Telegram/SourceFiles/data/data_channel.cpp | 2 ++
 Telegram/SourceFiles/data/data_session.cpp | 3 ++-
 Telegram/SourceFiles/data/data_user.cpp    | 2 ++
 3 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/Telegram/SourceFiles/data/data_channel.cpp b/Telegram/SourceFiles/data/data_channel.cpp
index caf4932c..4c00992e 100644
--- a/Telegram/SourceFiles/data/data_channel.cpp
+++ b/Telegram/SourceFiles/data/data_channel.cpp
@@ -1215,10 +1215,12 @@ const Data::AllowedReactions &ChannelData::allowedReactions() const {
 }
 
 bool ChannelData::hasActiveStories() const {
+	return false; // telegram-custom: no stories
 	return flags() & Flag::HasActiveStories;
 }
 
 bool ChannelData::hasUnreadStories() const {
+	return false; // telegram-custom: no stories
 	return flags() & Flag::HasUnreadStories;
 }
 
diff --git a/Telegram/SourceFiles/data/data_session.cpp b/Telegram/SourceFiles/data/data_session.cpp
index 49a6a033..fbd079b6 100644
--- a/Telegram/SourceFiles/data/data_session.cpp
+++ b/Telegram/SourceFiles/data/data_session.cpp
@@ -419,7 +419,8 @@ Session::Session(not_null<Main::Session*> session)
 			}
 		}, _lifetime);
 
-		_stories->loadMore(Data::StorySourcesList::NotHidden);
+		// telegram-custom: no stories strip above the chat list.
+		// _stories->loadMore(Data::StorySourcesList::NotHidden);
 	});
 
 	session->appConfig().ignoredRestrictionReasonsChanges(
diff --git a/Telegram/SourceFiles/data/data_user.cpp b/Telegram/SourceFiles/data/data_user.cpp
index 74fb1836..fdb57930 100644
--- a/Telegram/SourceFiles/data/data_user.cpp
+++ b/Telegram/SourceFiles/data/data_user.cpp
@@ -228,10 +228,12 @@ void UserData::setPrivateForwardName(const QString &name) {
 }
 
 bool UserData::hasActiveStories() const {
+	return false; // telegram-custom: no stories
 	return flags() & Flag::HasActiveStories;
 }
 
 bool UserData::hasUnreadStories() const {
+	return false; // telegram-custom: no stories
 	return flags() & Flag::HasUnreadStories;
 }
 
